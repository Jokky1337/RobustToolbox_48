preset raw;

#include "/Shaders/Internal/shadow_cast_shared.swsl"

#include "/Shaders/Internal/fov_shared.swsl"

// g_MinVariance держим в 0: положительное значение давало VSM-«протечку» света у углов стен
// (странные мягкие градиенты в углах). Сглаживание кромки обеспечивают сами 9 угловых тапов.
const highp float g_MinVariance = 0.0;
uniform highp vec4 occludeColor;

// Structura (§7.9 «FOV по форме спрайта»): маски силуэтов. Контент (FovSpriteRevealSystem) рисует
// в МИРОВОМ прямоугольнике [revealLB .. revealLB + 1/revealInvSize] две альфа-маски: revealMask —
// anchor-ВИДИМЫЙ высокий арт (вычитается из затемнения: спрайт открыт ЦЕЛИКОМ по форме), concealMask —
// анchor-СКРЫТЫЙ (затемнение до 1: спрайт закрыт целиком — сырая кромка маски не режет его арт
// диагональю). Граница видимости по носителям становится по-спрайтовой. revealEnabled=0 → сток.
uniform sampler2D revealMask;
uniform sampler2D concealMask;
uniform highp vec2 fovEyePos;
uniform highp vec2 revealLB;
uniform highp vec2 revealInvSize;
uniform highp float revealEnabled;

// Гейн reveal-гало (2026-07-20): у самого окклюдера полутень физически нулевая — «корни» теней стартуют
// бритвой, и на фоне ярко-открытого спрайта торчат чёрными шипами. Гейн >1 доводит ближнюю часть гало
// (альфа ≥ 1/gain) до ПОЛНОГО подавления маски — корни вокруг открытого арта гаснут, дальние хвосты клина
// остаются градиентом. 1.0 = чистое гало без усиления.
const highp float fovRevealGain = 1.8;

// Structura (форк, ADR-015): МЯГКАЯ кромка FOV.
// Оригинал делал бинарный обрез — `if (!doesOcclude(...)) discard; COLOR.a = 1.0` — из-за чего граница
// видно/тень была бритвенной: это луч постоянного угла из глаза через угол стены (полярная shadow-map),
// то есть жёсткая диагональ-клин. Здесь семплим маску несколькими тапами ВДОЛЬ перпендикуляра к лучу
// взгляда (= поперёк угловой границы) и усредняем видимость по Чебышёву (VSM). Получаем плавную alpha
// от 0 (видно) до 1 (тень). Техника зеркалит движковый light-soft.swsl. Ядро тени остаётся непрозрачным
// (темнота сохраняется), смягчается только сама кромка. fovSoftness — ширина фезера (главный тюн-винт).
// 4.0: шире (6) при 9 тапах даёт ВИДИМЫЕ ПОЛОСЫ/ВЕЕРА (редкий шаг + smoothstep усиливает дискретность,
// тапы перетягивают за короткие пилоны проёмов). 4 — плотные тапы, чистая кромка без артефактов.
// 2026-07-20 (§7.9): 4.0 → 6.0 — рядом с гало спрайт-реведила (радиус ~100) узкие угловые клинья базовой
// маски в зазорах между силуэтами читались «острыми треугольниками»; при 25 плотных тапах 6.0 полос не даёт
// (полосы были у 9 тапов). Если полосы всё же вернутся — сперва поднять fovDither, потом откатывать ширину.
const highp float fovSoftness = 6.0;

// Дистанц-скейл шага перп-тапов. КОРЕНЬ боксов у проёма (регрессия 5348021cc): шаг перпендикуляра —
// ФИКСИРОВАННЫЙ в мире (fovSoftness/32 = 0.125 тайла), а в УПОР это большой угловой шаг, и тапы (особенно
// ±4) перетягивают за край короткого окклюдера/узкого проёма в фон (дальняя cleared-глубина читается как
// «видно») → 9-среднее портится скачком → жёсткий бокс. Скейлим шаг на min(1, ourDist/clamp): вблизи
// (< clamp тайлов) короче — нет перетяга; далеко — полный шаг, мягкость кромки коридора сохраняется.
// Винт: меньше clamp = резче вблизи (но точнее у стен), больше = мягче, но риск боксов вернётся.
// 2026-07-20 (§7.9): 2.5 → 1.2 — вплотную к стенам клинья базовой маски оставались бритвой при ЛЮБОЙ
// ширине пера (кламп его схлопывал), на фоне мягкого гало спрайт-реведила читались «треугольниками».
// Если вернулись жёсткие боксы у коротких пилонов/проёмов — поднимать обратно к 2.0-2.5.
const highp float fovNearClamp = 1.2;

// ЛЁГКАЯ добивка дизером поверх 25 тапов: основную гладкость даёт плотность тапов, дизер лишь размывает
// остаточные мелкие ступени vis ДО smoothstep. Держим МАЛЫМ (0.05), чтобы не вернуть зерно как было на 0.15.
// Тюн через rldshader: 0 = чистые тапы (вернуть остаточные полосы, если есть), больше = глаже, но зерно.
const highp float fovDither = 0.05;

// РАДИАЛЬНЫЙ фезер (2026-07-20, «торчащие углы»): перп-тапы смягчают только УГЛОВЫЕ границы (клин
// постоянного угла); границы ПО ГЛУБИНЕ — срез реведила «видно внутрь стены», вершины теневых клиньев,
// стыки полос — оставались бритвой, и на их пересечениях с угловыми кромками торчали жёсткие углы.
// Градиент по (ourDist − глубина карты): первые fovRadialFeather тайлов ЗА границей тень набирается
// плавно → срезы скругляются, углы стыков смягчаются с обеих сторон. Ядро страхует core (не светлеет).
// Тюн: 0.25 старт → 0.45 (2026-07-20, §7.9: вершины клиньев в зазорах между силуэтами против гало ~100
// оставались колючими); меньше = резче, 0 = выкл (прежнее поведение). ⚠️ rldshader этот файл НЕ перечитывает
// (движковый Internal) — только ребилд + рестарт клиента.
const highp float fovRadialFeather = 14.4 / 32.0;

void fragment()
{
    highp float ourDist = length(worldSpaceDiff);

    // Перпендикуляр к лучу: (dy,-dx). Длина = ourDist, нормируем → шаг fovSoftness/32 мира,
    // *min(1, ourDist/fovNearClamp): вблизи шаг короче (нет перетяга за окклюдер → нет боксов у проёма).
    highp vec2 perp = vec2(worldSpaceDiff.y, -worldSpaceDiff.x) / max(ourDist, 0.0001)
        * (fovSoftness / 32.0) * min(1.0, ourDist / fovNearClamp);

    // 25 тапов поперёк угловой границы с шагом perp/3 (та же ширина ±4·perp, ВТРОЕ плотнее прежних 9):
    // vis даёт ~25 уровней вместо 9 → ступени намного мельче, переход гладкий. Чебышёв(moments, ourDist) ≈
    // видимость (1 — перед окклюдером, 0 — за). Бинарность тапов у резкого края проёма гасится плотностью.
    highp vec2 pf = perp / 3.0;
    highp float vis =
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff,            TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf,        TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf,        TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf * 2.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf * 2.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf * 3.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf * 3.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf * 4.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf * 4.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf * 5.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf * 5.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf * 6.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf * 6.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf * 7.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf * 7.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf * 8.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf * 8.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf * 9.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf * 9.0,  TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf * 10.0, TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf * 10.0, TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf * 11.0, TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf * 11.0, TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff + pf * 12.0, TEXTURE, 0.75), ourDist) +
        ChebyshevUpperBound(occludeDepth(worldSpaceDiff - pf * 12.0, TEXTURE, 0.75), ourDist);
    vis = vis / 25.0;

    // Дизер ПРОТИВ ПОЛОС у ИСТОЧНИКА: размываем дискретные уровни vis (~k/9) шумом ДО smoothstep, только в
    // переходной зоне (0.55<vis<0.999) — видимое (vis≈1) и ядро тени (vis<0.55) не трогаем, чтобы не зашуметь
    // весь экран. Хэш от worldSpaceDiff (смещение глаз→пиксель) стабилен в мире (не ползёт за камерой) и даёт
    // пер-пиксельный шум → ступени рассыпаются, после smoothstep переход гладкий.
    if (vis > 0.55 && vis < 0.999)
    {
        highp float visDither = fract(sin(dot(worldSpaceDiff, vec2(12.9898, 78.233))) * 43758.5453) - 0.5;
        vis = clamp(vis + visDither * fovDither, 0.0, 1.0);
    }

    // alpha маски = «затенённость». Мягкая кромка живёт в smoothstep(1-vis): полоса плавно (C1, без
    // бритвы) насыщается в непрозрачное, и просвет яркого unshaded-эмиттера (glow ламп) через фезер
    // падает до ~0 уже при vis≳0.62 — лампа на кромке FOV больше не «светит из темноты». Видимая сторона
    // остаётся градиентом (у smoothstep нулевой наклон на концах). 0.45 — порог насыщения (ниже →
    // агрессивнее/у́же, выше → мягче); fovSoftness=6 компенсирует сужение.
    //
    // Порядок композита: hard-FOV блитит чёрным с alpha=a ПОВЕРХ кадра (Clyde.HLR.cs:574), сцена
    // просвечивает на яркости (1-a). core держит ЯДРО окклюзии непрозрачным (один центральный тест с
    // отриц. bias): 9-тапное среднее у углов «дотягивается» перп-тапами за край стены → 1-vis<1 в ядре →
    // unshaded просвечивал бы. core поднимает alpha до 1 строго ЗА окклюдером (по центральному лучу); на
    // видимой стороне occludeDepth далёкий, тест не проходит → core=0, кромку не трогает.
    //
    // Симметричную дилатацию ядра по перп-тапам НЕ делаем: OR-max симметричен → чернит и ВИДИМЫЕ пиксели
    // в ±perp от границы (жёсткий чёрный воротник на свету = та же бритва). Band-просвет душит smoothstep,
    // ядро — центральный core. Лампу в ПРЯМОЙ видимости (a=0) маской скрыть нельзя — это притемнение
    // эмиттера (контент), не FOV.
    // Одно чтение глубины по центральному лучу кормит И core-тест, И радиальный фезер.
    highp vec2 centreDepth = occludeDepth(worldSpaceDiff, TEXTURE, 0.75);
    highp float over = ourDist - centreDepth.x;

    // core отступает на ширину радиального фезера (иначе чернил бы ramp уже в ~1px за срезом): ядро
    // непрозрачно строго ГЛУБЖЕ фезера. Анти-glow ламп в полосе фезера чуть мягче — тюн fovRadialFeather.
    highp float core = float(over > fovRadialFeather + 0.75 / 32.0);

    // Радиальный кап тени: на ЛИТ-стороне (over<0) = 1.0 — угловой фезер работает РОВНО как раньше;
    // на теневой стороне первые fovRadialFeather тайлов за границей глубины тень набирается плавно →
    // срезы реведила и вершины клиньев скругляются, «торчащие углы» стыков смягчаются. Глубже — cap=1,
    // угловое значение нетронуто. max(...,0.0001) = защита smoothstep при fovRadialFeather=0 (выкл).
    highp float shadeCap = mix(1.0,
        smoothstep(0.0, max(fovRadialFeather, 0.0001), over),
        step(0.0, over));

    highp float a = max(min(smoothstep(0.0, 0.45, 1.0 - vis), shadeCap), core);

    // §7.9: reveal выводит пиксели видимого арта из затемнения (ПОСЛЕ core — обязан пробивать и ядро),
    // conceal доводит скрытый арт до полной тьмы (кромка маски не режет его диагональю). При наложении
    // артов (свес верхнего над нижним) побеждает conceal: пиксель на экране показывает ВЕРХНИЙ спрайт.
    if (revealEnabled > 0.5)
    {
        highp vec2 ruv = (fovEyePos + worldSpaceDiff - revealLB) * revealInvSize;
        if (ruv.x > 0.0 && ruv.x < 1.0 && ruv.y > 0.0 && ruv.y < 1.0)
        {
            a *= 1.0 - clamp(texture2D(revealMask, ruv).a * fovRevealGain, 0.0, 1.0);
            a = max(a, clamp(texture2D(concealMask, ruv).a, 0.0, 1.0));
        }
    }

    if (a <= 0.004)
    {
        discard;
    }

    COLOR = vec4(occludeColor.rgb, a);
}
