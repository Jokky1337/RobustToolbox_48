preset raw;

// Structura (§7.9): passthrough-композит размытой FOV-маски в кадр. Маска отрисована в офскрин
// (fov.swsl → FovMaskTarget), размыта (light-blur), и этим шейдером кладётся поверх кадра обычным
// альфа-блендом. discard зеркалит порог fov.swsl — пустые пиксели не пишут стенсил.

varying highp vec2 pos;

void vertex()
{
    VERTEX = apply_mvp(VERTEX);
    pos = (VERTEX + vec2(1.0)) / 2.0;
}

void fragment()
{
    highp vec4 c = texture2D(TEXTURE, pos);
    if (c.a <= 0.004)
    {
        discard;
    }

    COLOR = c;
}
