preset raw;

// Structura: where the light comes from (Clyde.LightRendering.DrawLightDirections, light.direction_map). The same
// lamp quad as the colour pass, the same attenuation, the lamp's mask and its wall shadows, but instead of colour it
// adds, with blend One/One into a float target: RG += w * (unit vector toward the lamp), B += w, A += w * distance,
// w being the lamp's brightness reaching this point. Content reads RG/B as the mean direction toward the light (its
// length: how one-sided the light is) and A/B as the mean distance.

#include "/Shaders/Internal/shadow_cast_shared.swsl"

const highp float LIGHTING_HEIGHT = 1.0;

const highp float g_MinVariance = 0.0;

varying highp vec2 worldPosition;

uniform highp vec4 lightColor;
uniform highp vec2 lightCenter;
uniform highp float lightRange;
uniform highp float lightPower;
uniform highp float lightFalloff;
uniform highp float lightCurveFactor;
uniform highp float lightIndex;
uniform sampler2D shadowMap;

void vertex()
{
    highp vec3 transformed = modelMatrix * vec3(VERTEX, 1.0);
    worldPosition = transformed.xy;
    transformed = projectionMatrix * viewMatrix * transformed;

    VERTEX = transformed.xy;
}

void fragment()
{
    highp float mask = zTexture(UV).r;

    highp vec2 diff = worldPosition - lightCenter;
    highp float dist = length(diff);

    highp float occlusion = 1.0;
    if (lightIndex >= 0.0)
    {
        occlusion = smoothstep(0.1, 1.0, ChebyshevUpperBound(occludeDepth(diff, shadowMap, lightIndex), dist));
    }

    if (occlusion <= 0.0)
    {
        discard;
    }

    // The colour pass's attenuation (light_shared.swsl).
    highp float sqr_dist = dot(diff, diff) + LIGHTING_HEIGHT;
    highp float s = clamp(sqrt(sqr_dist) / lightRange, 0.0, 1.0);
    highp float s2 = s * s;
    highp float curveFactor = mix(s, s2, clamp(lightCurveFactor, 0.0, 1.0));
    highp float val = clamp(((1.0 - s2) * (1.0 - s2)) / (1.0 + lightFalloff * curveFactor), 0.0, 1.0);

    highp float brightness = max(lightColor.r, max(lightColor.g, lightColor.b));
    highp float w = val * lightPower * mask * occlusion * brightness;
    highp vec2 toLight = dist > 0.0001 ? -diff / dist : vec2(0.0);
    COLOR = vec4(toLight * w, w, w * dist);
}
